  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/UserProfile" }, "description": "User profile & preferences" },
    "/users/{userId}/salat_amol/{dayKey}": { "schema": { "$ref": "#/entities/SalatAmolLog" }, "description": "Daily Salat & Amol tracker" },
    "/users/{userId}/ai_chats/{chatId}": { "schema": { "$ref": "#/entities/AiChatSession" }, "description": "AI chat session" },
    "/users/{userId}/ai_chats/{chatId}/messages/{msgId}": { "schema": { "$ref": "#/entities/AiChatMessage" }, "description": "AI chat message" },
    "/foundation_settings/{settingId}": { "schema": { "$ref": "#/entities/FoundationSettings" }, "description": "Foundation config" },
    "/members/{memberId}": { "schema": { "$ref": "#/entities/Member" }, "description": "Members & Committee" },
    "/funds/{fundId}": { "schema": { "$ref": "#/entities/Fund" }, "description": "Sectors/Funds" },
    "/transactions/{txId}": { "schema": { "$ref": "#/entities/Transaction" }, "description": "Donations, expenses, and fees" },
    "/projects/{projectId}": { "schema": { "$ref": "#/entities/Project" }, "description": "Active projects" },
    "/blood_requests/{requestId}": { "schema": { "$ref": "#/entities/BloodRequest" }, "description": "Emergency blood requests" },
    "/blood_donors/{donorId}": { "schema": { "$ref": "#/entities/BloodDonor" }, "description": "Blood donors" },
    "/relief_locations/{locationId}": { "schema": { "$ref": "#/entities/ReliefLocation" }, "description": "Relief map pins" },
    "/field_reports/{reportId}": { "schema": { "$ref": "#/entities/FieldReport" }, "description": "Verified field works" },
    "/events/{eventId}": { "schema": { "$ref": "#/entities/FoundationEvent" }, "description": "Events & calendar" },
    "/notices/{noticeId}": { "schema": { "$ref": "#/entities/Notice" }, "description": "Official notices" },
    "/polls/{pollId}": { "schema": { "$ref": "#/entities/Poll" }, "description": "Member polls" },
    "/polls/{pollId}/votes/{voterId}": { "schema": { "$ref": "#/entities/PollVote" }, "description": "Secret per-user vote" },
    "/voices/{voiceId}": { "schema": { "$ref": "#/entities/VoiceTestimonial" }, "description": "Testimonials" },
    "/chat_messages/{msgId}": { "schema": { "$ref": "#/entities/ChatMessage" }, "description": "Community & fund chat" },
    "/duties/{dutyId}": { "schema": { "$ref": "#/entities/VolunteerDuty" }, "description": "Volunteer duties" },
    "/public_requests/{reqId}": { "schema": { "$ref": "#/entities/PublicRequest" }, "description": "Private aid, contact, and membership applications" }
  }
}
