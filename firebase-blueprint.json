{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile, linked member code, and theme preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "memberCode": { "type": "string" },
        "themePalette": { "type": "string" },
        "themeBg": { "type": "string" },
        "darkMode": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Must be FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "displayName", "role", "createdAt", "updatedAt"]
    },
    "SalatAmolLog": {
      "title": "SalatAmolLog",
      "description": "User daily Salat prayer and Amol completion tracker",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "dateKey": { "type": "string" },
        "prayers": { "type": "array" },
        "amolDone": { "type": "array" },
        "tasbihTotal": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "dateKey", "prayers", "amolDone", "tasbihTotal", "createdAt", "updatedAt"]
    },
